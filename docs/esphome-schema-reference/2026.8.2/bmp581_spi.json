                "MODE1": null,
                "MODE2": null,
                "MODE3": null,
                "0": null,
                "1": null,
                "2": null,
                "3": null
              }
            }
          },
          "extends": [
            "bmp581_base.CONFIG_SCHEMA_BASE"
          ]
