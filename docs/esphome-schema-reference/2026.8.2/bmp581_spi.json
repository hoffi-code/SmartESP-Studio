                "output"
              ],
              "schema": true,
              "type": "pin",
              "docs": "**[Pin Schema](https://esphome.io/guides/configuration-types#pin-schema)**: The SPI CS pin connected to the BMP581 sensor.\n\n*See also: [BMP581 Temperature+Pressure Sensor](https://esphome.io/components/sensor/bmp581#configuration-variables)*"
            },
            "data_rate": {
              "key": "Optional"
            },
