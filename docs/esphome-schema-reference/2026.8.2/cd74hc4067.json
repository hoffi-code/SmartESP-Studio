              ],
              "schema": true,
              "type": "pin"
            },
            "pin_s3": {
              "key": "Required",
              "modes": [
                "output"
              ],
              "schema": true,
              "type": "pin"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
