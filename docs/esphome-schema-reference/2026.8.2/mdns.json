{
  "mdns": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "disabled": {
              "default": "False",
              "key": "Optional",
              "type": "boolean",
              "docs": "**boolean**: Set to true to disable mDNS usage. Defaults to false.\n\n*See also: [mDNS Component](https://esphome.io/components/mdns#configuration-variables)*"
            },
            "id": {
              "id_type": {
                "class": "mdns::MDNSComponent",
                "parents": [
                  "Component"
                ]
              },
              "key": "GeneratedID"
            },
            "services": {
              "default": "[]",
              "is_list": true,
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "port": {
                    "data_type": "port",
                    "default": "0",
                    "key": "Optional",
                    "templatable": true,
                    "type": "integer",
                    "docs": "**int**: Port number of extra service.\n\n*See also: [mDNS Component](https://esphome.io/components/mdns#configuration-variables)*"
                  },
                  "protocol": {
                    "key": "Required",
                    "type": "string",
                    "docs": "**string**: Protocol of service (`_udp` or `_tcp`).\n\n*See also: [mDNS Component](https://esphome.io/components/mdns#configuration-variables)*"
                  },
                  "service": {
                    "key": "Required",
                    "type": "string",
                    "docs": "**string**: Name of extra service.\n\n*See also: [mDNS Component](https://esphome.io/components/mdns#configuration-variables)*"
                  },
                  "txt": {
                    "default": "{}",
                    "key": "String",
                    "key_type": "string",
                    "schema": {
                      "config_vars": {
                        "string": {
                          "templatable": true,
                          "type": "string"
                        }
                      }
                    },
                    "type": "schema"
                  }
                }
              },
              "type": "schema",
              "docs": "**list**: List of additional services to expose.\n\n*See also: [mDNS Component](https://esphome.io/components/mdns#configuration-variables)*"
            }
          }
        },
        "type": "schema"
      }
    }
  }
}