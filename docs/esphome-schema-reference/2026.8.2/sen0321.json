{
  "sen0321.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "accuracy_decimals": {
              "default": "1"
            },
            "address": {
              "data_type": "hex_uint8_t",
              "default": "115",
              "key": "Optional",
              "docs": "**int**: Manually specify the I\u00b2C address of the sensor. Defaults to `0x73`. Sensor can be configured to `0x70`, `0x71`, `0x72`, or `0x73` using jumpers on the board.\n\n*See also: [SEN0321 DFRobot Ozone Sensor](https://esphome.io/components/sensor/sen0321#configuration-variables)*"
            },
            "i2c_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "i2c::I2CBus"
            },
            "icon": {
              "default": "mdi:chemical-weapon"
            },
            "id": {
              "id_type": {
                "class": "sen0321_sensor::Sen0321Sensor",
                "parents": [
                  "sensor::Sensor",
                  "EntityBase",
                  "PollingComponent",
                  "Component",
                  "i2c::I2CDevice"
                ]
              }
            },
            "state_class": {
              "default": "measurement"
            },
            "unit_of_measurement": {
              "default": "ppb"
            },
            "update_interval": {
              "default": "60s",
              "key": "Optional",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The interval to check the sensor. Defaults to `60s`.\n\n*See also: [SEN0321 DFRobot Ozone Sensor](https://esphome.io/components/sensor/sen0321#configuration-variables)*"
            }
          },
          "extends": [
            "sensor._SENSOR_SCHEMA",
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}