{
  "dlms_meter": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "auth_key": {
              "key": "Optional",
              "sensitive": true,
              "sensitive_source": "explicit",
              "docs": "**string**: Authentication key. Specify if your smart meter uses encryption with\n\n*See also: [DLMS Meter](https://esphome.io/components/sensor/dlms_meter#configuration-variables)*"
            },
            "custom_patterns": {
              "is_list": true,
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "default_obis": {
                    "key": "Optional"
                  },
                  "name": {
                    "key": "Optional",
                    "type": "string"
                  },
                  "pattern": {
                    "key": "Required",
                    "type": "string"
                  },
                  "priority": {
                    "default": "0",
                    "key": "Optional",
                    "type": "integer"
                  }
                }
              },
              "type": "schema",
              "docs": "**list**: While the `dlms_meter` natively supports most devices, some meters use\n\n*See also: [DLMS Meter](https://esphome.io/components/sensor/dlms_meter#configuration-variables)*"
            },
            "decryption_key": {
              "key": "Optional",
              "sensitive": true,
              "sensitive_source": "explicit",
              "docs": "**string**: Specify if your smart meter uses encryption. You should request this key\n\n*See also: [DLMS Meter](https://esphome.io/components/sensor/dlms_meter#configuration-variables)*"
            },
            "id": {
              "id_type": {
                "class": "dlms_meter::DlmsMeterComponent",
                "parents": [
                  "Component",
                  "uart::UARTDevice"
                ]
              },
              "key": "GeneratedID",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: The ID of the `dlms_meter` component.\n\n*See also: [DLMS Meter](https://esphome.io/components/sensor/dlms_meter#configuration-variables)*"
            },
            "provider": {
              "key": "Optional",
              "type": "string"
            },
            "receive_timeout": {
              "default": "1000ms",
              "key": "Optional",
              "schema": {
                "extends": [
                  "core.positive_time_period_milliseconds"
                ]
              },
              "type": "schema",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The timeout for receiving a complete frame. Defaults to `1000ms`.\n\n*See also: [DLMS Meter](https://esphome.io/components/sensor/dlms_meter#configuration-variables)*"
            },
            "skip_crc": {
              "default": "False",
              "key": "Optional",
              "type": "boolean",
              "docs": "**boolean**: Skip CRC check. Some smart meters use the wrong polynomial to calculate CRC.\n\n*See also: [DLMS Meter](https://esphome.io/components/sensor/dlms_meter#configuration-variables)*"
            },
            "uart_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "uart::UARTComponent",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: The ID of the UART component that is\n\n*See also: [DLMS Meter](https://esphome.io/components/sensor/dlms_meter#configuration-variables)*"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  },
