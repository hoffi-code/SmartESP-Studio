{
  "sht4x.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "address": {
              "data_type": "hex_uint8_t",
              "default": "68",
              "key": "Optional",
              "docs": "**int**: Manually specify the I\u00b2C address of the sensor. Default is `0x44`.\n\n*See also: [SHT4X Temperature and Humidity Sensor](https://esphome.io/components/sensor/sht4x#configuration-variables)*"
            },
            "heater_max_duty": {
              "default": "0.0",
              "key": "Optional",
              "docs": "**float**: The maximum duty cycle of the heater (limited to `0.05`  ). Default is `0.0`, i.e. heater off.\n\n*See also: [SHT4X Temperature and Humidity Sensor](https://esphome.io/components/sensor/sht4x#configuration-variables)*"
            },
            "heater_power": {
              "default": "High",
              "key": "Optional",
              "type": "enum",
              "values": {
                "High": null,
                "Med": null,
                "Low": null
              },
              "docs": "**string**: The heater power, either `High`, `Med` or `Low`. Default is `High`.\n\n*See also: [SHT4X Temperature and Humidity Sensor](https://esphome.io/components/sensor/sht4x#configuration-variables)*"
            },
            "heater_time": {
              "default": "Long",
              "key": "Optional",
              "type": "enum",
              "values": {
                "Long": null,
                "Short": null
              },
              "docs": "**string**: The length of time to run the heater, either `Long` (1000ms) or `Short` (100ms). Default is `Long`.\n\n*See also: [SHT4X Temperature and Humidity Sensor](https://esphome.io/components/sensor/sht4x#configuration-variables)*"
            },
            "humidity": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "device_class": {
                    "default": "humidity"
                  },
                  "icon": {
                    "default": "mdi:water-percent"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "%"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Relative Humidity.\n\n*See also: [SHT4X Temperature and Humidity Sensor](https://esphome.io/components/sensor/sht4x#configuration-variables)*"
            },
            "i2c_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "i2c::I2CBus"
            },
            "id": {
              "id_type": {
                "class": "sht4x::SHT4XComponent",
                "parents": [
                  "PollingComponent",
                  "Component",
                  "sensirion_common::SensirionI2CDevice",
                  "i2c::I2CDevice"
                ]
              },
              "key": "GeneratedID"
            },
            "precision": {
              "default": "High",
              "key": "Optional",
              "type": "enum",
              "values": {
                "High": null,
                "Med": null,
                "Low": null
              },
              "docs": "**string**: The measurement precision, either `High`, `Med` or `Low`. Default is `High`.\n\n*See also: [SHT4X Temperature and Humidity Sensor](https://esphome.io/components/sensor/sht4x#configuration-variables)*"
            },
            "temperature": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "device_class": {
                    "default": "temperature"
                  },
                  "icon": {
                    "default": "mdi:thermometer"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "\u00b0C"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Temperature.\n\n*See also: [SHT4X Temperature and Humidity Sensor](https://esphome.io/components/sensor/sht4x#configuration-variables)*"
            },
            "update_interval": {
              "default": "60s",
              "key": "Optional",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The interval to check the sensor. Defaults to `60s`.\n\n*See also: [SHT4X Temperature and Humidity Sensor](https://esphome.io/components/sensor/sht4x#configuration-variables)*"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}