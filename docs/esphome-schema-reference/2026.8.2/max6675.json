{
  "max6675.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "accuracy_decimals": {
              "default": "1"
            },
            "cs_pin": {
              "key": "Required",
              "modes": [
                "output"
              ],
              "schema": true,
              "type": "pin",
              "docs": "**[Pin Schema](https://esphome.io/guides/configuration-types#pin-schema)**: The Chip Select pin of the SPI interface.\n\n*See also: [MAX6675 K-Type Thermocouple Temperature Sensor](https://esphome.io/components/sensor/max6675#configuration-variables)*"
            },
            "data_rate": {
              "key": "Optional"
            },
            "device_class": {
              "default": "temperature"
            },
            "id": {
              "id_type": {
                "class": "max6675::MAX6675Sensor",
                "parents": [
                  "sensor::Sensor",
                  "EntityBase",
                  "PollingComponent",
                  "Component",
                  "spi::SPIDevice"
                ]
              }
            },
            "release_device": {
              "key": "Optional",
              "type": "boolean"
            },
            "spi_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "spi::SPIComponent",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID of the [SPI Component](https://esphome.io/components/spi) if you want to use multiple SPI buses.\n\n*See also: [MAX6675 K-Type Thermocouple Temperature Sensor](https://esphome.io/components/sensor/max6675#configuration-variables)*"
            },
            "spi_mode": {
              "key": "Optional",
              "type": "enum",
              "values": {
                "MODE0": null,
                "MODE1": null,
                "MODE2": null,
                "MODE3": null,
                "0": null,
                "1": null,
                "2": null,
                "3": null
              }
            },
            "state_class": {
              "default": "measurement"
            },
            "unit_of_measurement": {
              "default": "\u00b0C"
            },
            "update_interval": {
              "default": "60s",
              "key": "Optional",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The interval to check the sensor. Defaults to `60s`.\n\n*See also: [MAX6675 K-Type Thermocouple Temperature Sensor](https://esphome.io/components/sensor/max6675#configuration-variables)*"
            }
          },
          "extends": [
            "sensor._SENSOR_SCHEMA",
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}