{
  "growatt_solar.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "active_power": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "device_class": {
                    "default": "power"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "W"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the (active) power value for the Grid in watts. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "address": {
              "data_type": "hex_uint8_t",
              "default": "1",
              "key": "Optional",
              "docs": "**int**: The address of the sensor if multiple sensors are attached to the same UART bus. You will need to set the address of each device manually. Defaults to `1`.\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "energy_production_day": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "energy"
                  },
                  "state_class": {
                    "default": "total_increasing"
                  },
                  "unit_of_measurement": {
                    "default": "kWh"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the export active energy value for same day of the sensor in kilo watt hours. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "frequency": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "device_class": {
                    "default": "frequency"
                  },
                  "icon": {
                    "default": "mdi:current-ac"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "Hz"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the frequency value of the sensor in hertz. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "id": {
              "id_type": {
                "class": "growatt_solar::GrowattSolar",
                "parents": [
                  "PollingComponent",
                  "Component",
                  "modbus::ModbusClientDevice"
                ]
              },
              "key": "GeneratedID"
            },
            "inverter_module_temp": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "temperature"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "\u00b0C"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the inverter module temperature value of the sensor in degree celsius. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "inverter_status": {
              "key": "Optional",
              "schema": {
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Status code of the inverter (0: waiting, 1: normal, 3:fault)\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "modbus_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "modbus::ModbusClientHub"
            },
            "phase_a": {
              "key": "Optional",
              "schema": {
                "extends": [
                  "growatt_solar.sensor.PHASE_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The group of exposed sensors for Phase A/1.\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "phase_b": {
              "key": "Optional",
              "schema": {
                "extends": [
                  "growatt_solar.sensor.PHASE_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The group of exposed sensors for Phase B/2 on applicable inverters.\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "phase_c": {
              "key": "Optional",
              "schema": {
                "extends": [
                  "growatt_solar.sensor.PHASE_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The group of exposed sensors for Phase C/3 on applicable inverters.\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "protocol_version": {
              "default": "RTU",
              "key": "Optional",
              "type": "enum",
              "values": {
                "RTU": null,
                "RTU2": null
              },
              "docs": "Version of the protocol used by your inverter. Old inverters use RTU (default). Newer ones use RTU2 (e.g. MIC, MIN, MAX series)\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "pv1": {
              "key": "Optional",
              "schema": {
                "extends": [
                  "growatt_solar.sensor.PV_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The group of exposed sensors for Photo Voltaic 1.\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "pv2": {
              "key": "Optional",
              "schema": {
                "extends": [
                  "growatt_solar.sensor.PV_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The group of exposed sensors for Photo Voltaic 2.\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "pv_active_power": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "device_class": {
                    "default": "power"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "W"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the (active) power value of PVs in total in watts. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "total_energy_production": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "energy"
                  },
                  "state_class": {
                    "default": "total_increasing"
                  },
                  "unit_of_measurement": {
                    "default": "kWh"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the total exported energy value of the sensor in kilo watt hours. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "update_interval": {
              "default": "10s",
              "key": "Optional",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The interval to check the sensor. Defaults to `10s`.\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      },
      "PHASE_SCHEMA": {
        "schema": {
          "config_vars": {
            "active_power": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "device_class": {
                    "default": "power"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "W"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the (active) power value of the sensor in watts. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "current": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "device_class": {
                    "default": "current"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "A"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the current value of the sensor in amperes. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "voltage": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "voltage"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "V"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the voltage value of the sensor in volts. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            }
          }
        },
        "type": "schema"
      },
      "PV_SCHEMA": {
        "schema": {
          "config_vars": {
            "active_power": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "device_class": {
                    "default": "power"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "W"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the (active) power value of the sensor in watts. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "current": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "device_class": {
                    "default": "current"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "A"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the current value of the sensor in amperes. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            },
            "voltage": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "voltage"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "V"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Use the voltage value of the sensor in volts. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Growatt Solar](https://esphome.io/components/sensor/growatt_solar#configuration-variables)*"
            }
          }
        },
        "type": "schema"
      }
    }
  }
}