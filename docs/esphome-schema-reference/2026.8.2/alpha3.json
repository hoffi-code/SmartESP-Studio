{
  "alpha3.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "ble_client_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "ble_client::BLEClient"
            },
            "current": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "device_class": {
                    "default": "current"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "A"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Current in `A`. All options from [Sensor](https://esphome.io/components/sensor)\n\n*See also: [Grundfos Alpha3](https://esphome.io/components/sensor/alpha3#configuration-variables)*"
            },
            "flow": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "m\u00b3/h"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The estimated volume flow of the medium in `m\u00b3/h`. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Grundfos Alpha3](https://esphome.io/components/sensor/alpha3#configuration-variables)*"
            },
            "head": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "m"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The estimated head (preasure difference generated by the pump) in `m`. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Grundfos Alpha3](https://esphome.io/components/sensor/alpha3#configuration-variables)*"
            },
            "id": {
              "id_type": {
                "class": "alpha3::Alpha3",
                "parents": [
                  "ble_client::BLEClientNode",
                  "PollingComponent",
                  "Component"
                ]
              },
              "key": "GeneratedID",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID used for code generation.\n\n*See also: [Grundfos Alpha3](https://esphome.io/components/sensor/alpha3#configuration-variables)*"
            },
            "power": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "device_class": {
                    "default": "power"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "W"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The power consumption of the pump in `W`. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Grundfos Alpha3](https://esphome.io/components/sensor/alpha3#configuration-variables)*"
            },
            "speed": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "RPM"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "the speed of the pump rotor in `RPM`. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Grundfos Alpha3](https://esphome.io/components/sensor/alpha3#configuration-variables)*"
            },
            "update_interval": {
              "default": "15s",
              "key": "Optional"
            },
            "voltage": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "device_class": {
                    "default": "voltage"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "V"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Voltage in `V`. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [Grundfos Alpha3](https://esphome.io/components/sensor/alpha3#configuration-variables)*"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}