{
  "mcp9600.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "address": {
              "data_type": "hex_uint8_t",
              "default": "103",
              "key": "Optional",
              "docs": "**int**: Manually specify the I\u00b2C address of the sensor. Defaults to `0x67`.\n\n*See also: [MCP9600 Thermocouple Amplifier](https://esphome.io/components/sensor/mcp9600#configuration-variables)*"
            },
            "cold_junction": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "temperature"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "\u00b0C"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The information for the Cold Junction temperature sensor.\n\n*See also: [MCP9600 Thermocouple Amplifier](https://esphome.io/components/sensor/mcp9600#configuration-variables)*"
            },
            "hot_junction": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "temperature"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "\u00b0C"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The information for the Hot Junction temperature sensor.\n\n*See also: [MCP9600 Thermocouple Amplifier](https://esphome.io/components/sensor/mcp9600#configuration-variables)*"
            },
            "i2c_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "i2c::I2CBus"
            },
            "id": {
              "id_type": {
                "class": "mcp9600::MCP9600Component",
                "parents": [
                  "PollingComponent",
                  "Component",
                  "i2c::I2CDevice"
                ]
              },
              "key": "GeneratedID"
            },
            "thermocouple_type": {
              "default": "K",
              "key": "Optional",
              "type": "enum",
              "values": {
                "K": null,
                "J": null,
                "T": null,
                "N": null,
                "S": null,
                "E": null,
                "B": null,
                "R": null
              },
              "docs": "Set the thermocouple type. Options are: K, J, T, N, S, E, B and R type thermocouple. Defaults to `K`.\n\n*See also: [MCP9600 Thermocouple Amplifier](https://esphome.io/components/sensor/mcp9600#configuration-variables)*"
            },
            "update_interval": {
              "default": "60s",
              "key": "Optional",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The interval to check the sensor. Defaults to `60s`.\n\n*See also: [MCP9600 Thermocouple Amplifier](https://esphome.io/components/sensor/mcp9600#configuration-variables)*"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}