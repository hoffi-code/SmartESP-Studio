{
  "cst328.binary_sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "cst328_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "cst328::CST328Touchscreen",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID of the touchscreen.\n\n*See also: [CST328 Touch Screen Controller](https://esphome.io/components/touchscreen/cst328#configuration-variables)*"
            },
            "id": {
              "id_type": {
                "class": "cst328::CST328Button",
                "parents": [
                  "binary_sensor::BinarySensor",
                  "EntityBase",
                  "Component",
                  "cst328::CST328ButtonListener",
                  "Parented<cst328::CST328Touchscreen>",
                  "Parented"
                ]
              }
            }
          },
          "extends": [
            "binary_sensor._BINARY_SENSOR_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  },
  "cst328.touchscreen": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "address": {
              "data_type": "hex_uint8_t",
              "default": "26",
              "key": "Optional"
            },
            "calibration": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "x_max": {
                    "key": "Required",
                    "type": "integer"
                  },
                  "x_min": {
                    "key": "Required",
                    "type": "integer"
                  },
                  "y_max": {
                    "key": "Required",
                    "type": "integer"
                  },
                  "y_min": {
                    "key": "Required",
                    "type": "integer"
                  }
                }
              },
              "type": "schema"
            },
            "display": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "display::Display"
            },
            "i2c_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "i2c::I2CBus"
            },
            "id": {
              "id_type": {
                "class": "cst328::CST328Touchscreen",
                "parents": [
                  "touchscreen::Touchscreen",
                  "PollingComponent",
                  "Component",
                  "i2c::I2CDevice"
                ]
              },
              "key": "GeneratedID",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually set the ID of this touchscreen.\n\n*See also: [CST328 Touch Screen Controller](https://esphome.io/components/touchscreen/cst328#configuration-variables)*"
            },
            "interrupt_pin": {
              "internal": true,
              "key": "Optional",
              "modes": [
                "input"
              ],
              "schema": true,
              "type": "pin",
              "docs": "**[Pin Schema](https://esphome.io/guides/configuration-types#pin-schema)**: The touch detection pin.\n\n*See also: [CST328 Touch Screen Controller](https://esphome.io/components/touchscreen/cst328#configuration-variables)*"
            },
            "on_release": {
              "key": "Optional",
              "type": "trigger"
            },
            "on_touch": {
              "key": "Optional",
              "type": "trigger"
            },
            "on_update": {
              "key": "Optional",
              "type": "trigger"
            },
            "reset_pin": {
              "key": "Optional",
              "modes": [
                "output"
              ],
              "schema": true,
              "type": "pin",
              "docs": "**[Pin Schema](https://esphome.io/guides/configuration-types#pin-schema)**: The chip reset pin.\n\n*See also: [CST328 Touch Screen Controller](https://esphome.io/components/touchscreen/cst328#configuration-variables)*"
            },
            "touch_timeout": {
              "default": "100ms",
              "key": "Optional",
              "schema": {
                "extends": [
                  "core.positive_time_period_milliseconds"
                ]
              },
              "type": "schema"
            },
            "transform": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "mirror_x": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean"
                  },
                  "mirror_y": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean"
                  },
                  "swap_xy": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean"
                  }
                }
              },
              "type": "schema"
            },
            "update_interval": {
              "default": "50ms",
              "key": "Optional"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}