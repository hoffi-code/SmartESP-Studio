{
  "mcp2515.canbus": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "clock": {
              "default": "8MHZ",
              "key": "Optional",
              "type": "enum",
              "values": {
                "8MHZ": null,
                "12MHZ": null,
                "16MHZ": null,
                "20MHZ": null
              },
              "docs": "**enum**: The frequency of the clock crystal used on the MCP2515 device. One of `8MHZ`, `12MHZ`, `16MHZ` or `20MHZ`. Defaults to `8MHZ`.\n\n*See also: [MCP2515](https://esphome.io/components/canbus/mcp2515#configuration-variables)*"
            },
            "cs_pin": {
              "key": "Required",
              "modes": [
                "output"
              ],
              "schema": true,
              "type": "pin",
              "docs": "**[Pin Schema](https://esphome.io/guides/configuration-types#pin-schema)**: Is used to signal to a SPI device when it should listen for data on the SPI bus. Each SPI device has its own `CS` line. Sometimes also called `SS`.\n\n*See also: [MCP2515](https://esphome.io/components/canbus/mcp2515#configuration-variables)*"
            },
            "data_rate": {
              "key": "Optional"
            },
            "id": {
              "id_type": {
                "class": "mcp2515::MCP2515",
                "parents": [
                  "canbus::CanbusComponent",
                  "Component",
                  "spi::SPIDevice"
                ]
              }
            },
            "mode": {
              "default": "NORMAL",
              "key": "Optional",
              "type": "enum",
              "values": {
                "NORMAL": {
                  "docs": null
                },
                "LOOPBACK": {
                  "docs": null
                },
                "LISTENONLY": {
                  "docs": null
                }
              },
              "docs": "**enum**: Operating mode. One of:\n\n*See also: [MCP2515](https://esphome.io/components/canbus/mcp2515#configuration-variables)*"
            },
            "release_device": {
              "key": "Optional",
              "type": "boolean"
            },
            "spi_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "spi::SPIComponent"
            },
            "spi_mode": {
              "key": "Optional",
              "type": "enum",
              "values": {
                "MODE0": null,
                "MODE1": null,
                "MODE2": null,
                "MODE3": null,
                "0": null,
                "1": null,
                "2": null,
                "3": null
              }
            }
          },
          "extends": [
            "canbus.CANBUS_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}