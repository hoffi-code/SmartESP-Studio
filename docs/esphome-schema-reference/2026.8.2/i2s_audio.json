{
  "i2s_audio": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "is_list": true,
        "schema": {
          "config_vars": {
            "i2s_bclk_pin": {
              "internal": true,
              "key": "Optional",
              "modes": [
                "output"
              ],
              "type": "pin",
              "docs": "**[Pin](https://esphome.io/guides/configuration-types#pin)**: The GPIO pin to use for the I\u00b2S `BCLK` *(Bit Clock)* signal, also referred to as `SCK` *(Serial Clock)*.\n\n*See also: [I\u00b2S Audio Component](https://esphome.io/components/i2s_audio#configuration-variables)*"
            },
            "i2s_lrclk_pin": {
              "internal": true,
              "key": "Required",
              "modes": [
                "output"
              ],
              "type": "pin",
              "docs": "**[Pin](https://esphome.io/guides/configuration-types#pin)**: The GPIO pin to use for the I\u00b2S `LRCLK` *(Left/Right Clock)* signal, also referred to as `WS` *(Word Select)* or `FS` *(Frame Sync)*.\n\n*See also: [I\u00b2S Audio Component](https://esphome.io/components/i2s_audio#configuration-variables)*"
            },
            "i2s_mclk_pin": {
              "internal": true,
              "key": "Optional",
              "modes": [
                "output"
              ],
              "type": "pin",
              "docs": "**[Pin](https://esphome.io/guides/configuration-types#pin)**: The GPIO pin to use for the I\u00b2S `MCLK` *(Master Clock)* signal.\n\n*See also: [I\u00b2S Audio Component](https://esphome.io/components/i2s_audio#configuration-variables)*"
            },
            "id": {
              "id_type": {
                "class": "i2s_audio::I2SAudioComponent",
                "parents": [
                  "Component"
                ]
              },
              "key": "GeneratedID",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID for this I\u00b2S bus if you need multiple.\n\n*See also: [I\u00b2S Audio Component](https://esphome.io/components/i2s_audio#configuration-variables)*"
            }
          }
        },
        "type": "schema"
      }
    }
  },
