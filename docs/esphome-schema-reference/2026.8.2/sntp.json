{
  "sntp.time": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "id": {
              "id_type": {
                "class": "sntp::SNTPComponent",
                "parents": [
                  "time::RealTimeClock",
                  "PollingComponent",
                  "Component"
                ]
              },
              "key": "GeneratedID"
            },
            "servers": {
              "default": "['0.pool.ntp.org', '1.pool.ntp.org', '2.pool.ntp.org']",
              "is_list": true,
              "key": "Optional",
              "docs": "**list of strings**: Choose up to 3 NTP servers that are used for the clock source. Defaults to `0.pool.ntp.org`, `1.pool.ntp.org` and `2.pool.ntp.org`\n\n*See also: [SNTP Time Source](https://esphome.io/components/time/sntp#configuration-variables)*"
            }
          },
          "extends": [
            "time.TIME_SCHEMA",
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}