{
  "ssd1322_spi.display": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "brightness": {
              "default": "1.0",
              "key": "Optional"
            },
            "cs_pin": {
              "key": "Optional",
              "modes": [
                "output"
              ],
              "schema": true,
              "type": "pin",
              "docs": "**[Pin Schema](https://esphome.io/guides/configuration-types#pin-schema)**: The CS pin.\n\n*See also: [SSD1322 OLED Display](https://esphome.io/components/display/ssd1322#configuration-variables)*"
            },
            "data_rate": {
              "key": "Optional"
            },
            "dc_pin": {
              "key": "Required",
              "modes": [
                "output"
              ],
              "schema": true,
              "type": "pin",
              "docs": "**[Pin Schema](https://esphome.io/guides/configuration-types#pin-schema)**: The DC pin.\n\n*See also: [SSD1322 OLED Display](https://esphome.io/components/display/ssd1322#configuration-variables)*"
            },
            "external_vcc": {
              "key": "Optional",
              "type": "boolean"
            },
            "id": {
              "id_type": {
                "class": "ssd1322_spi::SPISSD1322",
                "parents": [
                  "ssd1322_base::SSD1322",
                  "PollingComponent",
                  "Component",
                  "display::DisplayBuffer",
                  "display::Display",
                  "PollingComponent",
                  "Component",
                  "spi::SPIDevice"
                ]
              },
              "key": "GeneratedID",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID used for code generation.\n\n*See also: [SSD1322 OLED Display](https://esphome.io/components/display/ssd1322#configuration-variables)*"
            },
            "model": {
              "key": "Required",
              "type": "enum",
              "values": {
                "SSD1322_256X64": null
              },
              "docs": "The model of the display. At present, only one option is available:\n\n*See also: [SSD1322 OLED Display](https://esphome.io/components/display/ssd1322#configuration-variables)*"
            },
            "release_device": {
              "key": "Optional",
              "type": "boolean"
            },
            "reset_pin": {
              "key": "Optional",
              "modes": [
                "output"
              ],
              "schema": true,
              "type": "pin",
              "docs": "**[Pin Schema](https://esphome.io/guides/configuration-types#pin-schema)**: The RESET pin.\n\n*See also: [SSD1322 OLED Display](https://esphome.io/components/display/ssd1322#configuration-variables)*"
            },
            "spi_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "spi::SPIComponent"
            },
            "spi_mode": {
              "key": "Optional",
              "type": "enum",
              "values": {
                "MODE0": null,
                "MODE1": null,
                "MODE2": null,
                "MODE3": null,
                "0": null,
                "1": null,
                "2": null,
                "3": null
              }
            },
            "update_interval": {
              "key": "Optional",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The interval to re-draw the screen. Defaults to `5s`.\n\n*See also: [SSD1322 OLED Display](https://esphome.io/components/display/ssd1322#configuration-variables)*"
            },
            "lambda": {
              "key": "Optional",
              "docs": "**[lambda](https://esphome.io/automations/templates#config-lambda)**: The lambda to use for rendering the content on the display. See [Display Rendering Engine](https://esphome.io/components/display#display-engine) for more information.\n\n*See also: [SSD1322 OLED Display](https://esphome.io/components/display/ssd1322#configuration-variables)*"
            },
            "pages": {
              "key": "Optional",
              "docs": "**list**: Show pages instead of a single lambda. See [Display Pages](https://esphome.io/components/display#display-pages).\n\n*See also: [SSD1322 OLED Display](https://esphome.io/components/display/ssd1322#configuration-variables)*"
            }
          },
          "extends": [
            "display.FULL_DISPLAY_SCHEMA",
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}