      "RC_SWITCH_PROTOCOL_SCHEMA": {
        "schema": {
          "config_vars": {
            "inverted": {
              "default": "False",
              "key": "Optional",
              "type": "boolean"
            },
            "one": {
              "data_type": "RC_SWITCH_TIMING_SCHEMA",
              "default": "[3, 1]",
              "key": "Optional"
            },
            "pulse_length": {
              "data_type": "uint32_t",
              "key": "Required",
              "type": "integer"
            },
            "sync": {
              "data_type": "RC_SWITCH_TIMING_SCHEMA",
              "default": "[1, 31]",
              "key": "Optional"
            },
