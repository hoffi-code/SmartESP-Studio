              "key": "Optional"
            }
          }
        },
        "type": "schema"
      },
      "REMOTE_TRANSMITTABLE_SCHEMA": {
        "schema": {
          "config_vars": {
            "transmitter_id": {
              "key": "GeneratedID",
              "type": "use_id",
