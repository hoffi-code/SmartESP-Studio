{
  "sy6970": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "is_list": true,
        "schema": {
          "config_vars": {
            "address": {
              "data_type": "hex_uint8_t",
              "default": "106",
              "key": "Optional",
              "docs": "**int**: The I\u00b2C address of the device. Defaults to `0x6A`.\n\n*See also: [SY6970 Battery Management IC](https://esphome.io/components/sensor/sy6970#configuration-variables)*"
            },
            "charge_current": {
              "default": "2048",
              "key": "Optional",
              "type": "integer"
            },
            "charge_enabled": {
              "default": "True",
              "key": "Optional",
              "type": "boolean",
              "docs": "**boolean**: Enable or disable charging. Defaults to `true`.\n\n*See also: [SY6970 Battery Management IC](https://esphome.io/components/sensor/sy6970#configuration-variables)*"
            },
            "charge_voltage": {
              "default": "4208",
              "key": "Optional",
              "type": "integer",
              "docs": "**int**: Charge voltage in millivolts. Accepts values between 3840 and 4608. Defaults to `4208`.\n\n*See also: [SY6970 Battery Management IC](https://esphome.io/components/sensor/sy6970#configuration-variables)*"
            },
            "enable_adc": {
              "default": "True",
              "key": "Optional",
              "type": "boolean",
              "docs": "**boolean**: Enable or disable the ADC. Defaults to `true`.\n\n*See also: [SY6970 Battery Management IC](https://esphome.io/components/sensor/sy6970#configuration-variables)*"
            },
            "enable_status_led": {
              "default": "True",
              "key": "Optional",
              "type": "boolean",
              "docs": "**boolean**: Enable or disable the status LED on the IC. Defaults to `true`.\n\n*See also: [SY6970 Battery Management IC](https://esphome.io/components/sensor/sy6970#configuration-variables)*"
            },
            "i2c_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "i2c::I2CBus"
            },
            "id": {
              "id_type": {
                "class": "sy6970::SY6970Component",
                "parents": [
                  "PollingComponent",
                  "Component",
                  "i2c::I2CDevice"
                ]
              },
              "key": "GeneratedID",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID used for code generation.\n\n*See also: [SY6970 Battery Management IC](https://esphome.io/components/sensor/sy6970#configuration-variables)*"
            },
            "input_current_limit": {
              "default": "500",
              "key": "Optional",
              "type": "integer",
              "docs": "**int**: Input current in milliamps. Accepts values between 100 and 3200. Defaults to `500`.\n\n*See also: [SY6970 Battery Management IC](https://esphome.io/components/sensor/sy6970#configuration-variables)*"
            },
            "precharge_current": {
              "default": "128",
              "key": "Optional",
              "type": "integer"
            },
            "update_interval": {
              "default": "5s",
              "key": "Optional",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The interval to check the sensor. Defaults to `5s`.\n\n*See also: [SY6970 Battery Management IC](https://esphome.io/components/sensor/sy6970#configuration-variables)*"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  },
