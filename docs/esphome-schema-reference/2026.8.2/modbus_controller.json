            },
            "write_lambda": {
              "key": "Optional"
            }
          },
          "extends": [
            "number._NUMBER_SCHEMA",
            "modbus_controller.ModbusItemBaseSchema"
          ]
        },
        "type": "schema"
      }
    }
  },
