{
  "modbus_controller": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "is_list": true,
        "schema": {
          "config_vars": {
            "address": {
              "data_type": "hex_uint8_t",
              "default": "1",
              "key": "Required",
              "docs": "**int**: start address of the first register in a range (can be decimal or hexadecimal).\n\n*See also: [Modbus Controller Text Sensor](https://esphome.io/components/text_sensor/modbus_controller#configuration-variables)*"
            },
            "allow_duplicate_commands": {
              "key": "Optional",
              "type": "boolean"
            },
            "command_throttle": {
              "key": "Optional",
              "schema": {
                "extends": [
                  "core.positive_time_period_milliseconds"
                ]
              },
              "type": "schema"
            },
            "id": {
              "id_type": {
                "class": "modbus_controller::ModbusController",
                "parents": [
                  "PollingComponent",
                  "Component"
                ]
              },
              "key": "GeneratedID",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID used for code generation.\n\n*See also: [Modbus Controller Output](https://esphome.io/components/output/modbus_controller#configuration-variables)*"
            },
            "max_cmd_retries": {
              "data_type": "positive_int",
              "default": "4",
              "key": "Optional",
              "type": "integer",
              "docs": "**integer**: How many times a command will be retried if no response is received. It doesn't include the initial transmission. Defaults to 4.\n\n*See also: [Modbus Controller](https://esphome.io/components/modbus_controller#configuration-variables)*"
            },
            "modbus_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "modbus::ModbusClientHub",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID of the `modbus` hub.\n\n*See also: [Modbus Controller](https://esphome.io/components/modbus_controller#configuration-variables)*"
            },
            "offline_skip_updates": {
              "data_type": "positive_int",
              "default": "0",
              "key": "Optional",
              "type": "integer",
              "docs": "**integer**: How many update intervals to wait between retry attempts while a device is offline (see below). Defaults to `0` (retry every update interval). If using a bus with multiple slaves, this avoids waiting for timeouts on an unresponsive device, allowing the other slaves on the same bus to be read on time.\n\n*See also: [Modbus Controller](https://esphome.io/components/modbus_controller#configuration-variables)*"
            },
            "on_command_sent": {
              "key": "Optional",
              "type": "trigger",
              "docs": "**[Automation](https://esphome.io/automations)**: An automation to perform when a modbus command has been sent. See [`on_command_sent`](https://esphome.io/components/modbus_controller#modbus_controller-on_command_sent)\n\n*See also: [Modbus Controller](https://esphome.io/components/modbus_controller#configuration-variables)*"
            },
            "on_offline": {
              "key": "Optional",
              "type": "trigger",
              "docs": "**[Automation](https://esphome.io/automations)**: An automation to perform when a modbus controller goes offline. See [`on_offline`](https://esphome.io/components/modbus_controller#modbus_controller-on_offline)\n\n*See also: [Modbus Controller](https://esphome.io/components/modbus_controller#configuration-variables)*"
            },
            "on_online": {
              "key": "Optional",
              "type": "trigger",
              "docs": "**[Automation](https://esphome.io/automations)**: An automation to perform when a modbus controller goes online. See [`on_online`](https://esphome.io/components/modbus_controller#modbus_controller-on_online)\n\n*See also: [Modbus Controller](https://esphome.io/components/modbus_controller#configuration-variables)*"
            },
            "update_interval": {
              "default": "60s",
              "key": "Optional",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The interval that the sensors should be checked. Defaults to 60 seconds.\n\n*See also: [Modbus Controller](https://esphome.io/components/modbus_controller#configuration-variables)*"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      },
      "ModbusItemBaseSchema": {
        "schema": {
          "config_vars": {
            "address": {
              "data_type": "positive_int",
              "key": "Optional",
              "type": "integer"
            },
            "bitmask": {
              "data_type": "hex_uint32_t",
              "default": "4294967295",
              "key": "Optional"
            },
            "byte_offset": {
              "data_type": "positive_int",
              "key": "Optional",
              "type": "integer"
            },
            "custom_command": {
              "data_type": "hex_uint8_t",
              "is_list": true,
              "key": "Optional"
            },
            "force_new_range": {
              "default": "False",
              "key": "Optional",
              "type": "boolean"
            },
            "lambda": {
              "key": "Optional"
            },
            "modbus_controller_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "modbus_controller::ModbusController"
            },
            "offset": {
              "data_type": "positive_int",
              "key": "Optional",
              "type": "integer"
            },
            "response_size": {
              "data_type": "positive_int",
              "default": "0",
              "key": "Optional",
              "type": "integer"
            },
            "skip_updates": {
              "data_type": "positive_int",
              "default": "0",
              "key": "Optional",
              "type": "integer"
            }
          }
        },
        "type": "schema"
      }
    }
  },
