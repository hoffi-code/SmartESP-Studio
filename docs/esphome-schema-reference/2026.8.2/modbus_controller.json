                "S_WORD": null,
                "S_WORD_S": null,
                "U_DWORD": null,
                "U_DWORD_R": null,
                "S_DWORD": null,
                "S_DWORD_R": null,
                "U_QWORD": null,
                "U_QWORD_R": null,
                "S_QWORD": null,
