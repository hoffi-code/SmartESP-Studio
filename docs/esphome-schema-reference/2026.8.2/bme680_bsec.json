{
  "bme680_bsec": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "is_list": true,
        "schema": {
          "config_vars": {
            "address": {
              "data_type": "hex_uint8_t",
              "default": "118",
              "key": "Optional",
              "docs": "**int**: Manually specify the I\u00b2C address of the sensor. Defaults to `0x76`. Another address can be `0x77`.\n\n*See also: [BME680 Temperature+Pressure+Humidity+Gas Sensor via BSEC](https://esphome.io/components/sensor/bme680_bsec#minimal-example-configuration-with-common-sensors)*"
            },
            "i2c_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "i2c::I2CBus"
            },
            "iaq_mode": {
              "default": "STATIC",
              "key": "Optional",
              "type": "enum",
              "values": {
                "STATIC": null,
                "MOBILE": null
              },
              "docs": "**string**: IAQ calculation mode. Default is `static` for static applications (e.g. fixed indoor devices). Can be `mobile` for mobile applications (e.g. carry-on devices).\n\n*See also: [BME680 Temperature+Pressure+Humidity+Gas Sensor via BSEC](https://esphome.io/components/sensor/bme680_bsec#minimal-example-configuration-with-common-sensors)*"
            },
            "id": {
              "id_type": {
                "class": "bme680_bsec::BME680BSECComponent",
                "parents": [
                  "Component",
                  "i2c::I2CDevice"
                ]
              },
              "key": "GeneratedID",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID used for code generation. Use this ID in the sensor section to refer to the correct BME680 if you have more than one device. This will also be used to refer to the calibrated BSEC algorithm state saved to flash.\n\n*See also: [BME680 Temperature+Pressure+Humidity+Gas Sensor via BSEC](https://esphome.io/components/sensor/bme680_bsec#minimal-example-configuration-with-common-sensors)*"
            },
            "sample_rate": {
              "default": "LP",
              "key": "Optional",
              "type": "enum",
              "values": {
                "LP": null,
                "ULP": null
              },
              "docs": "**string**: Sample rate. Default is `lp` for low power consumption, sampling every 3 seconds. Can be `ulp` for ultra-low power, sampling every 5 minutes. This controls the sampling rate for gas-dependent sensors and will govern the interval at which the sensor heater is operated. By default, this rate will also be used for temperature, pressure, and humidity sensors but these can be overridden on a per-sensor level if required.\n\n*See also: [BME680 Temperature+Pressure+Humidity+Gas Sensor via BSEC](https://esphome.io/components/sensor/bme680_bsec#minimal-example-configuration-with-common-sensors)*"
            },
            "state_save_interval": {
              "default": "6hours",
              "key": "Optional",
              "schema": {
                "extends": [
                  "core.positive_time_period_minutes"
                ]
              },
              "type": "schema",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The minimum interval at which to save calibrated BSEC algorithm state to flash so that calibration doesn't have to start from zero on device restart. Defaults to `6h`.\n\n*See also: [BME680 Temperature+Pressure+Humidity+Gas Sensor via BSEC](https://esphome.io/components/sensor/bme680_bsec#minimal-example-configuration-with-common-sensors)*"
            },
            "supply_voltage": {
              "default": "3.3V",
              "key": "Optional",
              "type": "enum",
              "values": {
                "1.8V": null,
                "3.3V": null
              },
              "docs": "**string**: Supply voltage of the sensor. Default is `3.3V`. Can be set to `1.8V` if your sensor is 1.8V-powered (e.g. the Pimoroni PIM357 BME680 Breakout module).\n\n*See also: [BME680 Temperature+Pressure+Humidity+Gas Sensor via BSEC](https://esphome.io/components/sensor/bme680_bsec#minimal-example-configuration-with-common-sensors)*"
            },
            "temperature_offset": {
              "default": "0",
              "key": "Optional",
              "docs": "**float**: Temperature offset if device is in enclosure and reads too high. This value is subtracted from the reading (e.g. if the sensor reads 5\u00b0C higher than expected, set this to `5`  ) and also corrects the relative humidity readings. Defaults to `0`.\n\n*See also: [BME680 Temperature+Pressure+Humidity+Gas Sensor via BSEC](https://esphome.io/components/sensor/bme680_bsec#minimal-example-configuration-with-common-sensors)*"
            }
          }
        },
        "type": "schema"
      }
    }
  },
  "bme680_bsec.sensor": {
