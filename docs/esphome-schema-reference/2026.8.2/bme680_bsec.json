  "bme680_bsec.text_sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "bme680_bsec_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "bme680_bsec::BME680BSECComponent",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Sets the ID of the bme680_bsec component to refer to. Useful when working with multiple devices.\n\n*See also: [BME680 Temperature+Pressure+Humidity+Gas Sensor via BSEC](https://esphome.io/components/sensor/bme680_bsec#text-sensor)*"
            },
            "iaq_accuracy": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "icon": {
                    "default": "mdi:checkbox-marked-circle-outline"
                  }
                },
                "extends": [
                  "text_sensor._TEXT_SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The information for the IAQ accuracy sensor. Shows: Stabilizing, Uncertain, Calibrating, Calibrated.\n\n*See also: [BME680 Temperature+Pressure+Humidity+Gas Sensor via BSEC](https://esphome.io/components/sensor/bme680_bsec#text-sensor)*"
            }
          }
        },
        "type": "schema"
      }
    }
  }
}