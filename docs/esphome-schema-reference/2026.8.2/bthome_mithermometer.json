                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The temperature, in \u00b0C. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [BTHome MiThermometer Sensor](https://esphome.io/components/sensor/bthome_mithermometer#configuration-variables)*"
            }
          },
          "extends": [
