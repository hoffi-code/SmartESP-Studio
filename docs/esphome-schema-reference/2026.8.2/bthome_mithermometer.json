                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "%"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The relative humidity, in %. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [BTHome MiThermometer Sensor](https://esphome.io/components/sensor/bthome_mithermometer#configuration-variables)*"
            },
            "id": {
