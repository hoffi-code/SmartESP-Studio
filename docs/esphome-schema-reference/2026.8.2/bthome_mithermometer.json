                  "device_class": {
                    "default": "battery"
                  },
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "%"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The battery level, in %. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [BTHome MiThermometer Sensor](https://esphome.io/components/sensor/bthome_mithermometer#configuration-variables)*"
            },
            "battery_voltage": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "3"
