                  "device_class": {
                    "default": "signal_strength"
                  },
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "dBm"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The signal strength (RSSI), in dBm. All options from [Sensor](https://esphome.io/components/sensor).\n\n*See also: [BTHome MiThermometer Sensor](https://esphome.io/components/sensor/bthome_mithermometer#configuration-variables)*"
            },
            "temperature": {
              "key": "Optional",
