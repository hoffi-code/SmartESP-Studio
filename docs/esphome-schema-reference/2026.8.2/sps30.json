{
  "sps30": {
    "action": {
      "start_fan_autoclean": {
        "schema": {
          "extends": [
            "sps30.sensor.SPS30_ACTION_SCHEMA"
          ]
        },
        "type": "schema",
        "docs": "This [action](https://esphome.io/automations/actions#all-actions) manually starts fan-cleaning."
      },
      "start_measurement": {
        "schema": {
          "extends": [
            "sps30.sensor.SPS30_ACTION_SCHEMA"
          ]
        },
        "type": "schema",
        "docs": "This [action](https://esphome.io/automations/actions#all-actions) manually puts the sensor into measurement mode."
      },
      "stop_measurement": {
        "schema": {
          "extends": [
            "sps30.sensor.SPS30_ACTION_SCHEMA"
          ]
        },
        "type": "schema",
        "docs": "This [action](https://esphome.io/automations/actions#all-actions) manually puts the sensor into idle mode."
      }
    }
  },
  "sps30.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "address": {
              "data_type": "hex_uint8_t",
              "default": "105",
              "key": "Optional",
              "docs": "**int**: Manually specify the I\u00b2C address of the sensor. Defaults to `0x69`.\n\n*See also: [SPS30 Particulate Matter Sensor](https://esphome.io/components/sensor/sps30#configuration-variables)*"
            },
            "auto_cleaning_interval": {
              "key": "Optional",
              "docs": "The interval in seconds of the periodic fan-cleaning.\n\n*See also: [SPS30 Particulate Matter Sensor](https://esphome.io/components/sensor/sps30#configuration-variables)*"
            },
            "i2c_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "i2c::I2CBus"
            },
            "id": {
              "id_type": {
                "class": "sps30::SPS30Component",
                "parents": [
                  "PollingComponent",
                  "Component",
                  "sensirion_common::SensirionI2CDevice",
                  "i2c::I2CDevice"
                ]
              },
              "key": "GeneratedID"
            },
            "idle_interval": {
              "key": "Optional",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: If specified, puts the sensor into idle mode between readings for the specified amount of time.\n\n*See also: [SPS30 Particulate Matter Sensor](https://esphome.io/components/sensor/sps30#configuration-variables)*"
            },
            "pm_10_0": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "2"
                  },
                  "device_class": {
                    "default": "pm10"
                  },
                  "icon": {
                    "default": "mdi:chemical-weapon"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "\u00b5g/m\u00b3"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The information for the **Weight Concentration** sensor for coarse particles up to 10\u03bcm. Readings in \u00b5g/m\u00b3.\n\n*See also: [SPS30 Particulate Matter Sensor](https://esphome.io/components/sensor/sps30#configuration-variables)*"
