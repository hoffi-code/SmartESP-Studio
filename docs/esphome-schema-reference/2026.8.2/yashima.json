{
  "yashima.climate": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "id": {
              "id_type": {
                "class": "yashima::YashimaClimate",
                "parents": [
                  "climate::Climate",
                  "EntityBase",
                  "Component"
                ]
              },
              "key": "GeneratedID"
            },
            "sensor": {
              "key": "Optional",
              "type": "use_id",
              "use_id_type": "sensor::Sensor"
            },
            "supports_cool": {
              "default": "True",
              "key": "Optional",
              "type": "boolean"
            },
            "supports_heat": {
              "default": "True",
              "key": "Optional",
              "type": "boolean"
            },
            "transmitter_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "remote_transmitter::RemoteTransmitterComponent"
            }
          },
          "extends": [
            "climate._CLIMATE_SCHEMA",
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}