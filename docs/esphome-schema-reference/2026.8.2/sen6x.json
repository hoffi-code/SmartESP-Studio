                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "device_class": {
                    "default": "carbon_dioxide"
                  },
                  "icon": {
                    "default": "mdi:molecule-co2"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "ppm"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "The **carbon dioxide** concentration in ppm. Note: only available with SEN63C, SEN66 or SEN69C. The sensor will be ignored on unsupported models.\n\n*See also: [SEN6x Series Environmental Sensor](https://esphome.io/components/sensor/sen6x#configuration-variables)*"
            },
            "formaldehyde": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "icon": {
                    "default": "mdi:radiator"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "ppb"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
