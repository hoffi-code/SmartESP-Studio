{
  "radon_eye_rd200.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "id": {
              "id_type": {
                "class": "radon_eye_rd200::RadonEyeRD200",
                "parents": [
                  "PollingComponent",
                  "Component",
                  "ble_client::BLEClientNode"
                ]
              },
              "key": "GeneratedID"
            },
            "radon": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "icon": {
                    "default": "mdi:radioactive"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "Bq/m\u00b3"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "radon_long_term": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "icon": {
                    "default": "mdi:radioactive"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "Bq/m\u00b3"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "update_interval": {
              "default": "5min",
              "key": "Optional"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA",
            "ble_client.BLE_CLIENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}