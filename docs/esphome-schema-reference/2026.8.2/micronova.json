{
  "micronova": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "enable_rx_pin": {
              "key": "Required",
              "modes": [
                "output"
              ],
              "schema": true,
              "type": "pin",
              "docs": "**[Pin](https://esphome.io/guides/configuration-types#pin)**: Output pin to be used to switch the line between RX and TX.\n\n*See also: [MicroNova based pellet stove](https://esphome.io/components/micronova#configuration-variables)*"
            },
            "id": {
              "id_type": {
                "class": "micronova::MicroNova",
                "parents": [
                  "Component",
                  "uart::UARTDevice"
                ]
              },
              "key": "GeneratedID"
            },
            "uart_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "uart::UARTComponent"
            }
          }
        },
        "type": "schema"
      }
    }
  },
  "micronova.button": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "custom_button": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "id": {
                    "id_type": {
                      "class": "micronova::MicroNovaButton",
                      "parents": [
                        "button::Button",
                        "EntityBase",
                        "Component"
                      ]
                    },
                    "key": "GeneratedID"
                  },
                  "memory_address": {
                    "key": "Required"
                  },
                  "memory_data": {
                    "key": "Required"
                  },
                  "memory_location": {
                    "key": "Required"
                  },
                  "micronova_id": {
                    "key": "GeneratedID",
                    "type": "use_id",
                    "use_id_type": "micronova::MicroNova"
                  }
                },
                "extends": [
                  "button._BUTTON_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "micronova_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "micronova::MicroNova"
            }
          }
        },
        "type": "schema"
      }
    }
  },
  "micronova.number": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "micronova_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "micronova::MicroNova"
            },
            "power_level": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "icon": {
                    "default": "mdi:flash"
                  },
                  "id": {
                    "id_type": {
                      "class": "micronova::MicroNovaNumber",
                      "parents": [
                        "number::Number",
                        "EntityBase",
                        "micronova::MicroNovaListener",
                        "PollingComponent",
                        "Component"
                      ]
                    },
                    "key": "GeneratedID"
                  },
                  "memory_address": {
                    "default": "127",
                    "key": "Optional"
                  },
                  "memory_location": {
                    "default": "32",
                    "key": "Optional"
                  },
                  "micronova_id": {
                    "key": "GeneratedID",
                    "type": "use_id",
                    "use_id_type": "micronova::MicroNova"
                  },
                  "update_interval": {
                    "default": "60s",
                    "key": "Optional"
                  }
                },
                "extends": [
                  "number._NUMBER_SCHEMA",
                  "core.COMPONENT_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "thermostat_temperature": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "device_class": {
                    "default": "temperature"
                  },
                  "id": {
                    "id_type": {
                      "class": "micronova::MicroNovaNumber",
                      "parents": [
                        "number::Number",
                        "EntityBase",
                        "micronova::MicroNovaListener",
                        "PollingComponent",
                        "Component"
                      ]
                    },
                    "key": "GeneratedID"
                  },
                  "memory_address": {
                    "default": "125",
                    "key": "Optional"
                  },
                  "memory_location": {
                    "default": "32",
                    "key": "Optional"
                  },
                  "micronova_id": {
                    "key": "GeneratedID",
                    "type": "use_id",
                    "use_id_type": "micronova::MicroNova"
                  },
                  "step": {
                    "default": "1.0",
                    "key": "Optional"
                  },
                  "unit_of_measurement": {
                    "default": "\u00b0C"
                  },
                  "update_interval": {
                    "default": "60s",
                    "key": "Optional"
                  }
                },
                "extends": [
                  "number._NUMBER_SCHEMA",
                  "core.COMPONENT_SCHEMA"
                ]
              },
              "type": "schema"
            }
          }
        },
        "type": "schema"
      }
    }
  },
