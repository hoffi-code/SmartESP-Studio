{
  "b_parasite.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "battery_voltage": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "3"
                  },
                  "device_class": {
                    "default": "voltage"
                  },
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "V"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Battery voltage in volts.\n\n*See also: [b-parasite](https://esphome.io/components/sensor/b_parasite#configuration-variables)*"
            },
            "ble_hub_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "ble_device_base::BLEHub"
            },
            "humidity": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "humidity"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "%"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Relative air humidity in %.\n\n*See also: [b-parasite](https://esphome.io/components/sensor/b_parasite#configuration-variables)*"
            },
            "id": {
              "id_type": {
                "class": "b_parasite::BParasite",
                "parents": [
                  "ble_device_base::ESPBTDeviceListener",
                  "Component"
                ]
              },
              "key": "GeneratedID"
            },
            "illuminance": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "device_class": {
                    "default": "illuminance"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "lx"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Illuminance in lux.\n\n*See also: [b-parasite](https://esphome.io/components/sensor/b_parasite#configuration-variables)*"
            },
            "mac_address": {
              "key": "Required",
              "docs": "The MAC address of the device.\n\n*See also: [b-parasite](https://esphome.io/components/sensor/b_parasite#configuration-variables)*"
            },
            "moisture": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "humidity"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "%"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Soil moisture in %.\n\n*See also: [b-parasite](https://esphome.io/components/sensor/b_parasite#configuration-variables)*"
            },
            "temperature": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "temperature"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "\u00b0C"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Air temperature in Celsius.\n\n*See also: [b-parasite](https://esphome.io/components/sensor/b_parasite#configuration-variables)*"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}