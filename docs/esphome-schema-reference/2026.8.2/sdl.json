  "sdl.display": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "dimensions": {
              "key": "Required",
              "schema": {
                "config_vars": {
                  "height": {
                    "key": "Required",
                    "type": "integer"
                  },
                  "width": {
                    "key": "Required",
                    "type": "integer"
                  }
                }
              },
              "type": "schema"
            },
            "id": {
              "id_type": {
                "class": "sdl::Sdl",
                "parents": [
                  "display::Display",
                  "PollingComponent",
                  "Component",
                  "Component"
                ]
              },
              "key": "GeneratedID",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID used for code generation.\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
            },
            "sdl_options": {
              "default": "",
              "key": "Optional",
              "docs": "**string**: Build arguments if required to specify include or library paths. Should not be required if SDL2 is properly installed.\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
            },
            "window_options": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "always_on_top": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean",
                    "docs": "**boolean**: Whether to always draw the display window above other windows or not\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
                  },
                  "borderless": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean",
                    "docs": "**boolean**: Whether to draw the display window with or without borders\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
                  },
                  "fullscreen": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean",
                    "docs": "**boolean**: Whether to draw the display window in fullscreen or not. This may resize the resolution of the host display to match the SDL display dimensions\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
                  },
                  "position": {
                    "key": "Optional",
                    "schema": {
                      "config_vars": {
                        "centered_on_display": {
                          "key": "Optional",
                          "type": "integer",
                          "docs": "**int**: For use with multiple display screens. Centers the window on the specified display number. Display numbering starts at 0. May not be used with `x` or `y`.\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
                        },
                        "x": {
                          "key": "Optional",
                          "type": "integer",
                          "docs": "**int**: X position of the display window in pixels\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
                        },
                        "y": {
                          "key": "Optional",
                          "type": "integer",
                          "docs": "**int**: Y position of the display window in pixels\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
                        }
                      }
                    },
                    "type": "schema",
                    "docs": "Specify the position of the display window on the host system. If not specified, SDL will choose a default position. Either `x` and `y` or `centered_on_display` may be used, but not together.\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
                  },
                  "resizable": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean",
                    "docs": "**boolean**: Whether the display window can be manually resized\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
                  },
                  "skip_taskbar": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean",
                    "docs": "**boolean**: Whether to skip adding a taskbar icon for the display window or not\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
                  }
                }
              },
              "type": "schema",
              "docs": "Options that affect how the display renders on the host system. All default to false, except position, which defaults to SDL's undefined position\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
            },
            "lambda": {
              "key": "Optional",
              "docs": "**[lambda](https://esphome.io/automations/templates#config-lambda)**: The lambda to use for rendering the content on the display. See [Display Rendering Engine](https://esphome.io/components/display#display-engine) for more information.\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
            },
            "update_interval": {
              "key": "Optional",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The interval to re-draw the screen. Defaults to `1s`.\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
            },
            "pages": {
              "key": "Optional",
              "docs": "**list**: Show pages instead of a single lambda. See [Display Pages](https://esphome.io/components/display#display-pages).\n\n*See also: [SDL2 Display on host platform](https://esphome.io/components/display/sdl#configuration-variables)*"
            }
          },
          "extends": [
            "display.FULL_DISPLAY_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  },
