                    "type": "boolean"
                  },
                  "open_drain": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean"
                  },
                  "output": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean"
                  },
                  "pulldown": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean"
                  },
                  "pullup": {
                    "default": "False",
                    "key": "Optional",
                    "type": "boolean"
                  }
                }
              },
              "type": "pin"
            },
            "number": {
              "key": "Required"
            }
          }
        },
        "type": "schema"
      }
