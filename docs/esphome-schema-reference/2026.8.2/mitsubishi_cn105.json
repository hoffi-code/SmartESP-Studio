                  "Parented"
                ]
              },
              "key": "GeneratedID"
            },
            "supported_swing_modes": {
              "default": "OFF",
              "key": "Optional",
              "type": "enum",
              "values": {
                "OFF": null,
                "BOTH": null,
                "VERTICAL": null,
                "HORIZONTAL": null
              }
            }
          },
          "extends": [
            "climate._CLIMATE_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  },
  "mitsubishi_cn105.select": {
