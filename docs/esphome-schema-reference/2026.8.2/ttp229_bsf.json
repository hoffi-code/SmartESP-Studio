                "class": "ttp229_bsf::TTP229BSFComponent",
                "parents": [
                  "Component"
                ]
              },
              "key": "GeneratedID"
            },
            "scl_pin": {
              "key": "Required",
              "modes": [
                "output"
              ],
              "schema": true,
              "type": "pin"
            },
            "sdo_pin": {
              "key": "Required",
              "modes": [
                "input",
                "pullup"
