                ]
              },
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually set the ID of this component.\n\n*See also: [TTP229 Capacitive Touch Sensor](https://esphome.io/components/binary_sensor/ttp229#configuration-variables)*"
            },
            "ttp229_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "ttp229_bsf::TTP229BSFComponent"
            }
          },
          "extends": [
            "binary_sensor._BINARY_SENSOR_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}