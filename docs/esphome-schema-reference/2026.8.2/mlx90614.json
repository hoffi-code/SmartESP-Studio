{
  "mlx90614.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "address": {
              "data_type": "hex_uint8_t",
              "default": "90",
              "key": "Optional"
            },
            "ambient": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "temperature"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "\u00b0C"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Enables sensor entity for ambient temperature reading.\n\n*See also: [MLX90614  non-contact thermometer](https://esphome.io/components/sensor/mlx90614#configuration-variables)*"
            },
            "i2c_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "i2c::I2CBus"
            },
            "id": {
              "id_type": {
                "class": "mlx90614::MLX90614Component",
                "parents": [
                  "PollingComponent",
                  "Component",
                  "i2c::I2CDevice"
                ]
              },
              "key": "GeneratedID"
            },
            "object": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "device_class": {
                    "default": "temperature"
                  },
                  "emissivity": {
                    "default": "1.0",
                    "key": "Optional",
                    "docs": "Emissivity coefficient is the measure of an object's ability to emit infrared energy compared to a theoretical perfect black body emitter. See [Emissivity Application note](https://media.melexis.com/-/media/files/documents/application-notes/mlx90614-changing-emissivity-unlocking-key-application-note-melexis.pdf?la=en) for details on determining custom emissivity. Default is 1.0 which is 100% and corresponds to the ideal black body.\n\n*See also: [MLX90614  non-contact thermometer](https://esphome.io/components/sensor/mlx90614#configuration-variables)*"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "\u00b0C"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "Enables sensor entity for object temperature reading.\n\n*See also: [MLX90614  non-contact thermometer](https://esphome.io/components/sensor/mlx90614#configuration-variables)*"
            },
            "update_interval": {
              "default": "60s",
              "key": "Optional"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  }
}