{
  "debug": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "id": {
              "id_type": {
                "class": "debug::DebugComponent",
                "parents": [
                  "PollingComponent",
                  "Component"
                ]
              },
              "key": "GeneratedID"
            },
            "update_interval": {
              "default": "60s",
              "key": "Optional"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  },
  "debug.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "block": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "icon": {
                    "default": "mdi:counter"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "B"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "cpu_frequency": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "device_class": {
                    "default": "frequency"
                  },
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "icon": {
                    "default": "mdi:speedometer"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "Hz"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "debug_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "debug::DebugComponent"
            },
            "fragmentation": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "1"
                  },
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "icon": {
                    "default": "mdi:counter"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "%"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "free": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "icon": {
                    "default": "mdi:counter"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "B"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "loop_time": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "icon": {
                    "default": "mdi:timer-outline"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "ms"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "min_free": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "icon": {
                    "default": "mdi:counter"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "B"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "psram": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "accuracy_decimals": {
                    "default": "0"
                  },
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "icon": {
                    "default": "mdi:counter"
                  },
                  "state_class": {
                    "default": "measurement"
                  },
                  "unit_of_measurement": {
                    "default": "B"
                  }
                },
                "extends": [
                  "sensor._SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            }
          }
        },
        "type": "schema"
      }
    }
  },
  "debug.text_sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "debug_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "debug::DebugComponent"
            },
            "device": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "icon": {
                    "default": "mdi:chip"
                  }
                },
                "extends": [
                  "text_sensor._TEXT_SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "reset_reason": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "entity_category": {
                    "default": "diagnostic"
                  },
                  "icon": {
                    "default": "mdi:restart"
                  }
                },
                "extends": [
                  "text_sensor._TEXT_SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            }
          }
        },
        "type": "schema"
      }
    }
  }
}