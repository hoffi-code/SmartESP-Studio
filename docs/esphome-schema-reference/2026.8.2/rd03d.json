                  "device_class": {
                    "default": "occupancy"
                  }
                },
                "extends": [
                  "binary_sensor._BINARY_SENSOR_SCHEMA"
                ]
              },
              "type": "schema",
              "docs": "True if any target is detected. All options from [Binary Sensor](https://esphome.io/components/binary_sensor#config-binary_sensor).\n\n*See also: [RD-03D mmWave Radar](https://esphome.io/components/sensor/rd03d#configuration-variables)*"
            },
            "target_1": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "device_class": {
                    "default": "occupancy"
                  }
                },
                "extends": [
                  "binary_sensor._BINARY_SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "target_2": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "device_class": {
                    "default": "occupancy"
                  }
                },
                "extends": [
                  "binary_sensor._BINARY_SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            },
            "target_3": {
              "key": "Optional",
              "schema": {
                "config_vars": {
                  "device_class": {
                    "default": "occupancy"
                  }
                },
                "extends": [
                  "binary_sensor._BINARY_SENSOR_SCHEMA"
                ]
              },
              "type": "schema"
            }
          }
        },
        "type": "schema"
      }
    }
  },
