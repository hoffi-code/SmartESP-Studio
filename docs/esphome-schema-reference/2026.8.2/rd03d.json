{
  "rd03d": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "is_list": true,
        "schema": {
          "config_vars": {
            "id": {
              "id_type": {
                "class": "rd03d::RD03DComponent",
                "parents": [
                  "Component",
                  "uart::UARTDevice"
                ]
              },
              "key": "GeneratedID",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID for this component.\n\n*See also: [RD-03D mmWave Radar](https://esphome.io/components/sensor/rd03d#configuration-variables)*"
            },
            "throttle": {
              "key": "Optional",
              "schema": {
                "extends": [
                  "core.positive_time_period_milliseconds"
                ]
              },
              "type": "schema",
              "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: Minimum time between sensor updates. The radar sends data very frequently; use this to reduce the update rate sent to Home Assistant. For example, ``500ms`` or ``1s``.\n\n*See also: [RD-03D mmWave Radar](https://esphome.io/components/sensor/rd03d#configuration-variables)*"
            },
            "tracking_mode": {
              "key": "Optional",
              "type": "enum",
              "values": {
                "single": null,
                "multi": null
              },
              "docs": "**string**: The tracking mode to configure. If not specified, no command is sent and the radar uses its default mode (typically multi-target). Requires a TX pin to be configured.\n\n*See also: [RD-03D mmWave Radar](https://esphome.io/components/sensor/rd03d#configuration-variables)*"
            },
            "uart_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "uart::UARTComponent",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID of the [UART Component](https://esphome.io/components/uart) to use. Required if you have multiple UARTs configured.\n\n*See also: [RD-03D mmWave Radar](https://esphome.io/components/sensor/rd03d#configuration-variables)*"
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  },
  "rd03d.binary_sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "schema": {
          "config_vars": {
            "rd03d_id": {
