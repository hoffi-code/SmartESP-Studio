{
  "ads1118": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "is_list": true,
        "schema": {
          "config_vars": {
            "cs_pin": {
              "key": "Required",
              "modes": [
                "output"
              ],
              "schema": true,
              "type": "pin",
              "docs": "**int**: The SPI cable select pin to use.\n\n*See also: [ADS1118 4-Channel 16-Bit A/D Converter with Internal Temperature Sensor](https://esphome.io/components/sensor/ads1118#configuration-variables)*"
            },
            "data_rate": {
              "key": "Optional"
            },
            "id": {
              "id_type": {
                "class": "ads1118::ADS1118",
                "parents": [
                  "Component",
                  "spi::SPIDevice"
                ]
              },
              "key": "GeneratedID",
              "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID for this ADS1118 Hub. Use this if you want to use multiple ADS1118 hubs at once.\n\n*See also: [ADS1118 4-Channel 16-Bit A/D Converter with Internal Temperature Sensor](https://esphome.io/components/sensor/ads1118#configuration-variables)*"
            },
            "release_device": {
              "key": "Optional",
              "type": "boolean"
            },
            "spi_id": {
              "key": "GeneratedID",
              "type": "use_id",
              "use_id_type": "spi::SPIComponent"
            },
            "spi_mode": {
              "key": "Optional",
              "type": "enum",
              "values": {
                "MODE0": null,
                "MODE1": null,
                "MODE2": null,
                "MODE3": null,
                "0": null,
                "1": null,
                "2": null,
                "3": null
              }
            }
          },
          "extends": [
            "core.COMPONENT_SCHEMA"
          ]
        },
        "type": "schema"
      }
    }
  },
  "ads1118.sensor": {
    "schemas": {
      "CONFIG_SCHEMA": {
        "type": "typed",
        "typed_key": "type",
        "types": {
          "adc": {
            "config_vars": {
              "accuracy_decimals": {
                "default": "3"
              },
              "ads1118_id": {
                "key": "GeneratedID",
                "type": "use_id",
                "use_id_type": "ads1118::ADS1118",
                "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID of the\n\n*See also: [ADS1118 4-Channel 16-Bit A/D Converter with Internal Temperature Sensor](https://esphome.io/components/sensor/ads1118#configuration-variables)*"
              },
              "device_class": {
                "default": "voltage"
              },
              "gain": {
                "key": "Required",
                "type": "enum",
                "values": {
                  "6.144": null,
                  "4.096": null,
                  "2.048": null,
                  "1.024": null,
                  "0.512": null,
                  "0.256": null
                },
                "docs": "**float**: The gain of this sensor.\n\n*See also: [ADS1118 4-Channel 16-Bit A/D Converter with Internal Temperature Sensor](https://esphome.io/components/sensor/ads1118#configuration-variables)*"
              },
              "id": {
                "id_type": {
                  "class": "ads1118::ADS1118Sensor",
                  "parents": [
                    "PollingComponent",
                    "Component",
                    "sensor::Sensor",
                    "EntityBase",
                    "voltage_sampler::VoltageSampler",
                    "Parented<ads1118::ADS1118>",
                    "Parented"
                  ]
                }
              },
              "multiplexer": {
                "key": "Required",
                "type": "enum",
                "values": {
                  "A0_A1": null,
                  "A0_A3": null,
                  "A1_A3": null,
                  "A2_A3": null,
                  "A0_GND": null,
                  "A1_GND": null,
                  "A2_GND": null,
                  "A3_GND": null
                },
                "docs": "The multiplexer channel of this sensor. Effectively means between which pins you want to measure voltage.\n\n*See also: [ADS1118 4-Channel 16-Bit A/D Converter with Internal Temperature Sensor](https://esphome.io/components/sensor/ads1118#configuration-variables)*"
              },
              "state_class": {
                "default": "measurement"
              },
              "unit_of_measurement": {
                "default": "V"
              },
              "update_interval": {
                "default": "60s",
                "key": "Optional",
                "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The interval to check the sensor. Defaults to `60s`.\n\n*See also: [ADS1118 4-Channel 16-Bit A/D Converter with Internal Temperature Sensor](https://esphome.io/components/sensor/ads1118#configuration-variables)*"
              }
            },
            "extends": [
              "sensor._SENSOR_SCHEMA",
              "core.COMPONENT_SCHEMA"
            ]
          },
          "temperature": {
            "config_vars": {
              "accuracy_decimals": {
                "default": "2"
              },
              "ads1118_id": {
                "key": "GeneratedID",
                "type": "use_id",
                "use_id_type": "ads1118::ADS1118",
                "docs": "**[ID](https://esphome.io/guides/configuration-types#id)**: Manually specify the ID of the\n\n*See also: [ADS1118 4-Channel 16-Bit A/D Converter with Internal Temperature Sensor](https://esphome.io/components/sensor/ads1118#configuration-variables)*"
              },
              "device_class": {
                "default": "temperature"
              },
              "id": {
                "id_type": {
                  "class": "ads1118::ADS1118Sensor",
                  "parents": [
                    "PollingComponent",
                    "Component",
                    "sensor::Sensor",
                    "EntityBase",
                    "voltage_sampler::VoltageSampler",
                    "Parented<ads1118::ADS1118>",
                    "Parented"
                  ]
                }
              },
              "state_class": {
                "default": "measurement"
              },
              "unit_of_measurement": {
                "default": "\u00b0C"
              },
              "update_interval": {
                "default": "60s",
                "key": "Optional",
                "docs": "**[Time](https://esphome.io/guides/configuration-types#time)**: The interval to check the sensor. Defaults to `60s`.\n\n*See also: [ADS1118 4-Channel 16-Bit A/D Converter with Internal Temperature Sensor](https://esphome.io/components/sensor/ads1118#configuration-variables)*"
              }
            },
            "extends": [
              "sensor._SENSOR_SCHEMA",
              "core.COMPONENT_SCHEMA"
            ]
          }
        },
        "docs": "`adc`  (default) or `temperature`"
      }
    }
  }
}