FROM node:22-alpine AS web

WORKDIR /app
COPY smartesp-studio-frontend/package.json smartesp-studio-frontend/package-lock.json smartesp-studio-frontend/.npmrc ./
RUN npm ci
COPY smartesp-studio-frontend/ .
RUN npm run build

FROM ghcr.io/esphome/esphome:2026.6.4

ARG BUILD_VERSION=dev
ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="SmartESP Studio"
LABEL org.opencontainers.image.description="Standalone Docker image for SmartESP Studio"
LABEL org.opencontainers.image.source="https://github.com/hoffi-code/SmartESP-Studio"
LABEL org.opencontainers.image.version="$BUILD_VERSION"
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.licenses="MIT"

ENV LANG=C.UTF-8
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV SES_MODE=standalone
ENV SES_VERSION=$BUILD_VERSION
ENV SES_PORT=8099
ENV PORT=8099

COPY smartesp-studio/requirements.txt /requirements.txt
RUN python3 -m venv /opt/designer-venv \
    && /opt/designer-venv/bin/python -m pip install --no-cache-dir -U pip \
    && /opt/designer-venv/bin/python -m pip install --no-cache-dir -r /requirements.txt

COPY smartesp-studio/server.py /server.py
COPY smartesp-studio/ses /ses
COPY smartesp-studio/run.sh /run.sh
COPY smartesp-studio/seed_esphome /seed_esphome
COPY smartesp-studio/logo.png /logo.png
COPY --from=web /app/dist /web
RUN chmod a+x /run.sh

EXPOSE 8099

# Override the esphome base image healthcheck (it probes the dashboard on :6052).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD curl -fsS http://localhost:8099/api/health || exit 1

ENTRYPOINT ["/run.sh"]
