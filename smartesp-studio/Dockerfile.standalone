FROM ghcr.io/esphome/esphome:2026.6.4

ARG BUILD_VERSION=dev
ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="SmartESP Studio"
LABEL org.opencontainers.image.description="Standalone Docker image for SmartESP Studio"
LABEL org.opencontainers.image.source="https://github.com/hoffi-code/SmartESP-Studio"
LABEL org.opencontainers.image.version="$BUILD_VERSION"
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.licenses="MIT"

ENV LANG=C.UTF-8
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV SES_MODE=standalone
ENV SES_VERSION=$BUILD_VERSION
ENV SES_PORT=8099
ENV PORT=8099

COPY requirements.txt /requirements.txt
RUN python3 -m venv /opt/designer-venv \
    && /opt/designer-venv/bin/python -m pip install --no-cache-dir -U pip \
    && /opt/designer-venv/bin/python -m pip install --no-cache-dir -r /requirements.txt

COPY server.py /server.py
COPY ses /ses
COPY run.sh /run.sh
COPY seed_esphome /seed_esphome
COPY logo.png /logo.png
COPY web /web
RUN chmod a+x /run.sh

EXPOSE 8099

ENTRYPOINT ["/run.sh"]
