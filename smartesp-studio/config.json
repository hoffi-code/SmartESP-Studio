{
  "name": "SmartESP Studio",
  "slug": "smartesp-studio",
  "description": "Ingress-only ESPHome editor. Build YAML, compile, and flash devices with live logs.",
  "version": "0.1.0",
  "build": "Dockerfile",
  "arch": ["amd64", "aarch64"],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "host_network": false,
  "ingress": true,
  "ingress_port": 8099,
  "watchdog": "http://[HOST]:8099/api/health",
  "logo": "logo.png",
  "icon": "logo.png",
  "panel_icon": "mdi:home-automation",
  "panel_title": "SmartESP Studio",
  "map": ["config:rw"],
  "devices": ["/dev/ttyUSB0", "/dev/ttyACM0"],
  "options": {
    "use_esphome_shared_path": false
  },
  "schema": {
    "use_esphome_shared_path": "bool"
  }
}
