{
  "id": "image.file",
  "domain": "image",
  "platform": "file",
  "helpUrl": "https://esphome.io/components/image/file/",
  "fields": [
    {
      "key": "id",
      "type": "id",
      "required": true,
      "lvl": "simple",
      "placeholder": "image_id"
    },
    {
      "key": "file",
      "type": "asset_ref",
      "assetKind": "images",
      "assetPathPrefix": "esp_assets/images/",
      "required": true,
      "lvl": "simple",
      "placeholder": "mdi:home / path/to/file.png"
    },
    {
      "key": "resize",
      "type": "text",
      "required": false,
      "lvl": "normal",
      "placeholder": "100x100"
    },
    {
      "key": "type",
      "type": "select",
      "required": true,
      "lvl": "simple",
      "options": [
        "BINARY",
        "GRAYSCALE",
        "RGB565",
        "RGB"
      ]
    },
    {
      "key": "transparency",
      "type": "select",
      "required": false,
      "lvl": "normal",
      "default": "opaque",
      "options": [
        "opaque",
        "chroma_key",
        "alpha_channel"
      ]
    },
    {
      "key": "invert_alpha",
      "type": "boolean",
      "required": false,
      "lvl": "advanced",
      "default": false
    },
    {
      "key": "dither",
      "type": "select",
      "required": false,
      "lvl": "advanced",
      "default": "NONE",
      "options": [
        "NONE",
        "FLOYDSTEINBERG"
      ],
      "dependsOn": {
        "key": "type",
        "value": "BINARY"
      }
    },
    {
      "key": "byte_order",
      "type": "select",
      "required": false,
      "lvl": "advanced",
      "default": "little_endian",
      "options": [
        "little_endian",
        "big_endian"
      ],
      "dependsOn": {
        "key": "type",
        "value": "RGB565"
      }
    },
    {
      "key": "custom_config",
      "type": "raw_yaml",
      "required": false,
      "lvl": "advanced"
    }
  ]
}
