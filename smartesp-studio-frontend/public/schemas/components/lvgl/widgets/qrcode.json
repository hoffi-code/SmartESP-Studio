{
  "id": "lvgl.widget.qrcode",
  "domain": "lvgl",
  "widgetType": "qrcode",
  "extends": "lvgl_widget_common.json",
  "helpUrl": "https://esphome.io/components/lvgl/widgets/qrcode/",
  "fields": [
    {
      "key": "text",
      "type": "text",
      "required": false,
      "lvl": "simple",
      "placeholder": "https://example.com"
    },
    {
      "key": "size",
      "type": "text",
      "required": false,
      "lvl": "normal",
      "placeholder": "100"
    },
    {
      "key": "dark_color",
      "type": "color",
      "required": false,
      "lvl": "normal",
      "placeholder": "0xRRGGBB",
      "colorFormat": "hex0x"
    },
    {
      "key": "light_color",
      "type": "color",
      "required": false,
      "lvl": "normal",
      "placeholder": "0xRRGGBB",
      "colorFormat": "hex0x"
    }
  ]
}
