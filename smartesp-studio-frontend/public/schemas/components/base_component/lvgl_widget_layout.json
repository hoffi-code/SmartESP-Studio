{
  "id": "base.lvgl_widget_layout",
  "domain": "lvgl",
  "type": "object",
  "extends": "lvgl_style_props.json",
  "fields": [
    {
      "key": "layout",
      "type": "object",
      "required": false,
      "lvl": "advanced",
      "group": "layout",
      "fields": [
        {
          "key": "type",
          "type": "select",
          "required": false,
          "options": ["FLEX", "GRID", "NONE"]
        },
        {
          "key": "flex_flow",
          "type": "select",
          "required": false,
          "options": [
            "ROW",
            "COLUMN",
            "ROW_WRAP",
            "COLUMN_WRAP",
            "ROW_REVERSE",
            "COLUMN_REVERSE",
            "ROW_WRAP_REVERSE",
            "COLUMN_WRAP_REVERSE"
          ]
        },
        {
          "key": "flex_align_main",
          "type": "select",
          "required": false,
          "options": ["START", "END", "CENTER", "SPACE_EVENLY", "SPACE_AROUND", "SPACE_BETWEEN"]
        },
        {
          "key": "flex_align_cross",
          "type": "select",
          "required": false,
          "options": ["START", "END", "CENTER"]
        },
        {
          "key": "flex_align_track",
          "type": "select",
          "required": false,
          "options": ["START", "END", "CENTER", "SPACE_EVENLY", "SPACE_AROUND", "SPACE_BETWEEN"]
        },
        {
          "key": "grid_columns",
          "type": "list",
          "required": false,
          "item": { "type": "text" },
          "placeholder": "FR(1)"
        },
        {
          "key": "grid_rows",
          "type": "list",
          "required": false,
          "item": { "type": "text" },
          "placeholder": "CONTENT"
        },
        {
          "key": "grid_column_align",
          "type": "select",
          "required": false,
          "options": ["START", "END", "CENTER", "STRETCH", "SPACE_EVENLY", "SPACE_AROUND", "SPACE_BETWEEN"]
        },
        {
          "key": "grid_row_align",
          "type": "select",
          "required": false,
          "options": ["START", "END", "CENTER", "STRETCH", "SPACE_EVENLY", "SPACE_AROUND", "SPACE_BETWEEN"]
        },
        {
          "key": "pad_row",
          "type": "text",
          "required": false,
          "placeholder": "0"
        },
        {
          "key": "pad_column",
          "type": "text",
          "required": false,
          "placeholder": "0"
        }
      ]
    },
    {
      "key": "align_to",
      "type": "object",
      "required": false,
      "lvl": "advanced",
      "group": "layout",
      "fields": [
        {
          "key": "id",
          "type": "id_ref",
          "required": false,
          "domain": "lvgl"
        },
        {
          "key": "align",
          "type": "select",
          "required": false,
          "options": [
            "TOP_LEFT",
            "TOP_MID",
            "TOP_RIGHT",
            "LEFT_MID",
            "CENTER",
            "RIGHT_MID",
            "BOTTOM_LEFT",
            "BOTTOM_MID",
            "BOTTOM_RIGHT",
            "OUT_TOP_LEFT",
            "OUT_TOP_MID",
            "OUT_TOP_RIGHT",
            "OUT_LEFT_TOP",
            "OUT_LEFT_MID",
            "OUT_LEFT_BOTTOM",
            "OUT_RIGHT_TOP",
            "OUT_RIGHT_MID",
            "OUT_RIGHT_BOTTOM",
            "OUT_BOTTOM_LEFT",
            "OUT_BOTTOM_MID",
            "OUT_BOTTOM_RIGHT"
          ]
        },
        { "key": "x", "type": "text", "required": false, "placeholder": "0" },
        { "key": "y", "type": "text", "required": false, "placeholder": "0" }
      ]
    },
    {
      "key": "flex_grow",
      "type": "text",
      "required": false,
      "lvl": "advanced",
      "group": "layout",
      "placeholder": "1"
    },
    {
      "key": "grid_cell_column_pos",
      "type": "text",
      "required": false,
      "lvl": "advanced",
      "group": "layout",
      "placeholder": "0"
    },
    {
      "key": "grid_cell_row_pos",
      "type": "text",
      "required": false,
      "lvl": "advanced",
      "group": "layout",
      "placeholder": "0"
    },
    {
      "key": "grid_cell_column_span",
      "type": "text",
      "required": false,
      "lvl": "advanced",
      "group": "layout",
      "placeholder": "1"
    },
    {
      "key": "grid_cell_row_span",
      "type": "text",
      "required": false,
      "lvl": "advanced",
      "group": "layout",
      "placeholder": "1"
    },
    {
      "key": "grid_cell_x_align",
      "type": "select",
      "required": false,
      "lvl": "advanced",
      "group": "layout",
      "options": ["START", "END", "CENTER", "STRETCH"]
    },
    {
      "key": "grid_cell_y_align",
      "type": "select",
      "required": false,
      "lvl": "advanced",
      "group": "layout",
      "options": ["START", "END", "CENTER", "STRETCH"]
    }
  ]
}
