{
  "id": "protocols.api",
  "domain": "api",
  "platform": "core",
  "helpUrl": "https://esphome.io/components/api/",
  "fields": [
    {
      "key": "enabled",
      "label": "Enable API",
      "type": "boolean",
      "required": false,
      "lvl": "simple",
      "default": true,
      "emitYAML": "never",
      "helpUrl": "https://esphome.io/components/api/"
    },
    {
      "key": "encryption",
      "type": "object",
      "required": false,
      "lvl": "simple",
      "emitYAML": "dependsOn",
      "helpUrl": "https://esphome.io/components/api/#encryption",
      "note": "Store the key as a secret (`key: !secret api_encryption_key`) and use the same value in Home Assistant.",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "fields": [
        {
          "key": "enable",
          "type": "boolean",
          "required": false,
          "lvl": "simple",
          "default": true,
          "emitYAML": "never"
        },
        {
          "key": "key",
          "type": "password",
          "required": false,
          "lvl": "simple",
          "emitYAML": "dependsOn",
          "placeholder": "SUy+LOZ1UM4OnR9/Y4fzhDgunMTG+VZWBklKsHLS9Pc=",
          "settings": {
            "format": "base64_44",
            "generator": {
              "mode": "base64",
              "onEmpty": true,
              "bytes": 32
            }
          },
          "dependsOn": {
            "key": "enable",
            "value": true
          }
        }
      ]
    },
    {
      "key": "id",
      "type": "id",
      "required": false,
      "placeholder": "my_api_id",
      "lvl": "normal",
      "dependsOn": {
        "key": "enabled",
        "value": true
      }
    },
    {
      "key": "actions",
      "type": "yaml",
      "required": false,
      "lvl": "normal",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "placeholder": "- logger.log: \"Hello\"",
      "helpUrl": "https://esphome.io/components/api/#actions"
    },
    {
      "key": "port",
      "type": "number",
      "required": false,
      "lvl": "advanced",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "placeholder": "6053"
    },
    {
      "key": "reboot_timeout",
      "type": "duration",
      "required": false,
      "lvl": "normal",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "placeholder": "15min",
      "note": "Set to `0s` to never reboot when no client is connected."
    },
    {
      "key": "batch_delay",
      "type": "duration",
      "required": false,
      "lvl": "advanced",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "placeholder": "100ms"
    },
    {
      "key": "listen_backlog",
      "type": "number",
      "required": false,
      "lvl": "advanced",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "placeholder": "1"
    },
    {
      "key": "max_connections",
      "type": "number",
      "required": false,
      "lvl": "advanced",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "placeholder": "4"
    },
    {
      "key": "max_send_queue",
      "type": "number",
      "required": false,
      "lvl": "advanced",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "placeholder": "4"
    },
    {
      "key": "custom_services",
      "type": "boolean",
      "required": false,
      "lvl": "advanced",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "default": false
    },
    {
      "key": "homeassistant_services",
      "label": "Home Assistant services",
      "type": "boolean",
      "required": false,
      "lvl": "advanced",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "default": false
    },
    {
      "key": "homeassistant_states",
      "label": "Home Assistant states",
      "type": "boolean",
      "required": false,
      "lvl": "advanced",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "default": false
    },
    {
      "key": "on_client_connected",
      "type": "list",
      "required": false,
      "lvl": "advanced",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "item": {
        "type": "object",
        "fields": [
          {
            "key": "then",
            "type": "list",
            "required": false,
            "lvl": "advanced",
            "item": {
              "type": "object",
              "fields": [],
              "extends": "base_actions.json"
            }
          }
        ]
      }
    },
    {
      "key": "on_client_disconnected",
      "type": "list",
      "required": false,
      "lvl": "advanced",
      "dependsOn": {
        "key": "enabled",
        "value": true
      },
      "item": {
        "type": "object",
        "fields": [
          {
            "key": "then",
            "type": "list",
            "required": false,
            "lvl": "advanced",
            "item": {
              "type": "object",
              "fields": [],
              "extends": "base_actions.json"
            }
          }
        ]
      }
    },
    {
      "key": "custom_config",
      "type": "raw_yaml",
      "required": false,
      "lvl": "advanced",
      "dependsOn": {
        "key": "enabled",
        "value": true
      }
    }
  ]
}
